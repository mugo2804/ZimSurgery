{
  "name": "zimmedpractice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZimMedPractice EHR & Practice Management",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:reset": "rm -rf .data/pglite && npm run setup",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@serwist/turbopack": "^9.5.13",
    "better-auth": "^1.7.14",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@serwist/build": {
      "zod": "$zod"
    },
    "@serwist/turbopack": {
      "zod": "$zod"
    }
  }
}
